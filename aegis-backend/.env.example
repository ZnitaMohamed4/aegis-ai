# ============================================================================
# AEGIS AI — Backend Environment Variables
# Copy this file to .env and fill in your values:  cp .env.example .env
# ============================================================================

# Django Core
SECRET_KEY=django-insecure-CHANGE-ME-IN-PRODUCTION
DEBUG=True

# PostgreSQL Database
DB_NAME=aegis_db
DB_USER=aegis_user
DB_PASSWORD=your_db_password
DB_HOST=localhost
DB_PORT=5432

# Redis (used for WebSockets + Latency Tracking)
REDIS_URL=redis://localhost:6379/1

# ML Pipeline — Paths relative to aegis-backend/
M1_MODEL_PATH=ml_pipeline/models/M1
M2_MODEL_PATH=ml_pipeline/models/M2
M1_THRESHOLD=0.48

# Set to True to use stub ML (no GPU needed, returns random predictions)
AEGIS_STUB_MODE=False

# Evolution API (WhatsApp Engine)
EVOLUTION_API_URL=http://localhost:5002
EVOLUTION_API_KEY=your_evolution_api_key

# Groq LLM API (Agent 3 — Grey Zone Classifier)
GROQ_API_KEY=your_groq_api_key
GROQ_MODEL=llama-3.3-70b-versatile

# Shadow Review — Catches "False Safes" where M1 says SAFE but text may be harmful
# If M1 score is between LOW and HIGH, Agent 3 (LLM) will double-check
# Set AEGIS_SHADOW_HIGH=0.0 to disable shadow review entirely
AEGIS_SHADOW_LOW=0.05
AEGIS_SHADOW_HIGH=0.30
AEGIS_SHADOW_MIN_WORDS=4
